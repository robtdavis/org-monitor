<?xml version="1.0" encoding="UTF-8" ?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Org Monitoring Dashboard</masterLabel>
    <description
  >View monitoring health, current org limit usage, and sample history.</description>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__AppPage,lightning__HomePage">
            <property
        name="demoMode"
        type="Boolean"
        label="Demo mode"
        default="false"
        description="Show generated demo data instead of org monitoring data."
      />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
